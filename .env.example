# URL del endpoint de Formspree para el formulario de contacto.
# Reemplaza el valor por el endpoint real del formulario.
VITE_FORMSPREE_URL=https://formspree.io/f/your-form-id

# Alternativa compatible con el código: también se acepta VITE_FORMSPREE_ENDPOINT.
# VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
